---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Magnitude ↔ Flux Ratio">
  <p class="breadcrumb"><a href={base}>Tools</a> / Magnitude ↔ Flux Ratio</p>
  <div class="page-header">
    <h1>Magnitude ↔ Flux Ratio</h1>
    <p>
      The magnitude scale is logarithmic: a difference of 5 magnitudes is exactly a
      factor of 100 in brightness. This converts between a magnitude difference and
      the corresponding flux (brightness) ratio, in both directions.
    </p>
  </div>

  <div class="panel">
    <h3 style="margin-top:0;">From two magnitudes</h3>
    <div class="field-row">
      <div class="field">
        <label for="mag-a">Magnitude A</label>
        <input type="number" id="mag-a" value="5.0" step="0.01" />
      </div>
      <div class="field">
        <label for="mag-b">Magnitude B</label>
        <input type="number" id="mag-b" value="6.0" step="0.01" />
      </div>
    </div>
    <div class="result">
      <div class="result-row"><span class="k">Δm (A − B)</span><span class="v" id="mag-diff">-1.0000</span></div>
      <div class="result-row"><span class="k">Flux A / Flux B</span><span class="v" id="mag-ratio-ab">0.398107</span></div>
      <div class="result-row"><span class="k">Flux B / Flux A</span><span class="v" id="mag-ratio-ba">2.511886</span></div>
      <div class="result-row"><span class="k">Brighter</span><span class="v" id="mag-brighter">B</span></div>
    </div>
  </div>

  <div class="panel" style="margin-top:1.25rem;">
    <h3 style="margin-top:0;">From a flux ratio</h3>
    <div class="field">
      <label for="ratio-in">Flux ratio (brighter / fainter)</label>
      <input type="number" id="ratio-in" value="2.512" step="0.001" min="0.0001" />
    </div>
    <div class="result">
      <div class="result-row"><span class="k">Magnitude difference</span><span class="v" id="ratio-out">1.0004</span></div>
    </div>
  </div>

  <p class="note">Uses the standard Pogson relation, Δm = −2.5 · log₁₀(F₁ / F₂). All computed in your browser.</p>
</Layout>

<script>
  const magA = document.getElementById('mag-a');
  const magB = document.getElementById('mag-b');
  const magDiff = document.getElementById('mag-diff');
  const ratioAB = document.getElementById('mag-ratio-ab');
  const ratioBA = document.getElementById('mag-ratio-ba');
  const brighter = document.getElementById('mag-brighter');

  function updateFromMagnitudes() {
    const a = Number(magA.value);
    const b = Number(magB.value);
    if (Number.isNaN(a) || Number.isNaN(b)) return;
    const diff = a - b;
    // A brighter object has a *smaller* magnitude, so flux_A/flux_B = 10^(-(a-b)/2.5)
    const fluxAB = Math.pow(10, -diff / 2.5);
    magDiff.textContent = diff.toFixed(4);
    ratioAB.textContent = fluxAB.toFixed(6);
    ratioBA.textContent = (1 / fluxAB).toFixed(6);
    brighter.textContent = diff === 0 ? 'equal' : diff < 0 ? 'A' : 'B';
  }

  [magA, magB].forEach((el) => el.addEventListener('input', updateFromMagnitudes));
  updateFromMagnitudes();

  const ratioIn = document.getElementById('ratio-in');
  const ratioOut = document.getElementById('ratio-out');

  function updateFromRatio() {
    const r = Number(ratioIn.value);
    if (Number.isNaN(r) || r <= 0) {
      ratioOut.textContent = '—';
      return;
    }
    const dm = 2.5 * Math.log10(r);
    ratioOut.textContent = dm.toFixed(4);
  }

  ratioIn.addEventListener('input', updateFromRatio);
  updateFromRatio();
</script>
