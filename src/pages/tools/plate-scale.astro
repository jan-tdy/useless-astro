---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---
<Layout title="Plate Scale & Sensor FOV">
  <p class="breadcrumb"><a href={base}>Tools</a> / Plate Scale & Sensor FOV</p>
  <div class="page-header">
    <h1>Plate Scale & Sensor FOV</h1>
    <p>Work out arcsec/pixel and the imaging field of view from your camera and optics.</p>
  </div>

  <div class="panel">
    <h3 style="margin-top:0;">Optics</h3>
    <div class="field-row">
      <div class="field">
        <label for="fl">Focal length (mm)</label>
        <input type="number" id="fl" value="1000" step="1" min="1" />
      </div>
    </div>

    <h3>Camera sensor</h3>
    <div class="field-row">
      <div class="field">
        <label for="pixel">Pixel size (µm)</label>
        <input type="number" id="pixel" value="3.76" step="0.01" min="0.1" />
      </div>
      <div class="field">
        <label for="res-x">Resolution width (px)</label>
        <input type="number" id="res-x" value="4144" step="1" min="1" />
      </div>
      <div class="field">
        <label for="res-y">Resolution height (px)</label>
        <input type="number" id="res-y" value="2822" step="1" min="1" />
      </div>
    </div>

    <div class="result">
      <div class="result-row"><span class="k">Plate scale</span><span class="v" id="out-scale">0.78″/px</span></div>
      <div class="result-row"><span class="k">Sensor width</span><span class="v" id="out-sensor-w">15.58 mm</span></div>
      <div class="result-row"><span class="k">Sensor height</span><span class="v" id="out-sensor-h">10.61 mm</span></div>
      <div class="result-row"><span class="k">Field of view (width)</span><span class="v" id="out-fov-w">53.5′</span></div>
      <div class="result-row"><span class="k">Field of view (height)</span><span class="v" id="out-fov-h">36.5′</span></div>
      <div class="result-row"><span class="k">Sampling</span><span class="v" id="out-sampling">—</span></div>
    </div>
  </div>

  <p class="note">
    Plate scale (″/px) = 206.265 × pixel size (µm) ÷ focal length (mm). Field of view = plate
    scale × resolution, converted to arcminutes. Sampling guidance assumes typical seeing of
    2–3″ FWHM: well under 1″/px oversamples, around 1–2″/px is a good match, and above roughly
    3″/px starts undersampling fine detail.
  </p>
</Layout>

<script>
  const fl = document.getElementById('fl');
  const pixel = document.getElementById('pixel');
  const resX = document.getElementById('res-x');
  const resY = document.getElementById('res-y');

  const outScale = document.getElementById('out-scale');
  const outSensorW = document.getElementById('out-sensor-w');
  const outSensorH = document.getElementById('out-sensor-h');
  const outFovW = document.getElementById('out-fov-w');
  const outFovH = document.getElementById('out-fov-h');
  const outSampling = document.getElementById('out-sampling');

  function arcminToDMString(totalArcmin) {
    if (totalArcmin >= 60) {
      const deg = Math.floor(totalArcmin / 60);
      const rem = totalArcmin - deg * 60;
      return `${deg}° ${rem.toFixed(1)}′`;
    }
    return `${totalArcmin.toFixed(1)}′`;
  }

  function samplingNote(arcsecPerPixel) {
    if (arcsecPerPixel < 1) return 'Oversampled for typical seeing';
    if (arcsecPerPixel <= 2) return 'Well matched to typical seeing';
    if (arcsecPerPixel <= 3) return 'Slightly undersampled';
    return 'Undersampled for typical seeing';
  }

  function update() {
    const focalLength = Number(fl.value);
    const pixelSize = Number(pixel.value);
    const widthPx = Number(resX.value);
    const heightPx = Number(resY.value);

    if (!focalLength || !pixelSize || !widthPx || !heightPx) return;

    const arcsecPerPixel = (206.265 * pixelSize) / focalLength;
    const sensorWidthMm = (pixelSize * widthPx) / 1000;
    const sensorHeightMm = (pixelSize * heightPx) / 1000;
    const fovWidthArcmin = (arcsecPerPixel * widthPx) / 60;
    const fovHeightArcmin = (arcsecPerPixel * heightPx) / 60;

    outScale.textContent = `${arcsecPerPixel.toFixed(2)}″/px`;
    outSensorW.textContent = `${sensorWidthMm.toFixed(2)} mm`;
    outSensorH.textContent = `${sensorHeightMm.toFixed(2)} mm`;
    outFovW.textContent = arcminToDMString(fovWidthArcmin);
    outFovH.textContent = arcminToDMString(fovHeightArcmin);
    outSampling.textContent = samplingNote(arcsecPerPixel);
  }

  [fl, pixel, resX, resY].forEach((el) => el.addEventListener('input', update));
  update();
</script>
