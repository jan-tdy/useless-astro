---
import '../styles/global.css';

const { title, description = 'A small collection of astronomy converters and pointless space toys.' } = Astro.props;
const pageTitle = title ? `${title} — Useless Astro` : 'Useless Astro';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <main>
      <div class="container">
        <p class="deprecation-banner">
          ⚠ Useless Astro is deprecated and no longer actively developed. All of its tools
          (and the fun pages) have moved to
          <a href="https://japysoft.bombol.space/tools">Visual Astro's Tools page</a>,
          where they're maintained going forward. This site is kept online as-is for existing
          links, but won't get new features or fixes.
        </p>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>Useless Astro — static, client-side, no accounts, no tracking.</span>
        <span>
          Need real observation logging? Try
          <a href="https://japysoft.bombol.space/info">Visual Astro</a>.
        </span>
      </div>
    </footer>
  </body>
</html>
